  "localization": {
    "ZS": {
      "name": "倭瓜僵尸",
      "description": "普通攻击：压扁     特殊攻击：-\n头上长着倭瓜的僵尸。\n抵达前线后倭瓜跳下压扁敌人，随后身体倒下。"
    },
    "ZT": {
      "name": "倭瓜殭屍",
      "description": "普通攻擊：壓扁     特殊攻擊：-\n頭上長著倭瓜的殭屍。\n抵達前線後倭瓜跳下壓扁敵人，隨後身體倒下。"
    },
    "JP": {
      "name": "スクワッシュゾンビ",
      "description": "通常攻撃：押しつぶし     特殊攻撃：-\nスクワッシュの頭をしたゾンビ。\n前線に着くと頭が飛びかかって敵を押しつぶし、体は倒れる。"
    },
    "EN": {
      "name": "SQUASH ZOMBIE",
      "description": "Normal attack: Crush     Special attack: -\nA zombie with a Squash for a head.\nAt the front line its head leaps off to crush enemies, then the body falls."
    },
    "ES": {
      "name": "ZOMBI CALABAZA",
      "description": "Ataque normal: Aplastar     Ataque especial: -\nUn zombi con una calabaza por cabeza.\nEn el frente su cabeza salta y aplasta a los enemigos; luego el cuerpo cae."
    },
    "PT": {
      "name": "ZUMBI ABÓBORA",
      "description": "Ataque normal: Esmagar     Ataque especial: -\nUm zumbi com uma abóbora na cabeça.\nNa linha de frente a cabeça salta e esmaga os inimigos; depois o corpo cai."
    },
    "KR": {
      "name": "스쿼시 좀비",
      "description": "일반 공격：짓누르기     특수 공격：-\n스쿼시 머리를 한 좀비.\n전선에 닿으면 머리가 뛰어올라 적을 짓누르고 몸은 쓰러진다."
    }
