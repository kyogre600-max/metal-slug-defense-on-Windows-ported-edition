    "ZS": {
      "name": "辣椒僵尸",
      "description": "普通攻击：烈焰     特殊攻击：-\n头上长着火爆辣椒的僵尸。\n碰到敌人时引燃覆盖全场的火焰，随后消失。"
    },
    "ZT": {
      "name": "辣椒殭屍",
      "description": "普通攻擊：烈焰     特殊攻擊：-\n頭上長著火爆辣椒的殭屍。\n碰到敵人時引燃覆蓋全場的火焰，隨後消失。"
    },
    "JP": {
      "name": "ハラペーニョゾンビ",
      "description": "通常攻撃：火炎     特殊攻撃：-\nハラペーニョの頭をしたゾンビ。\n敵に触れると戦場全体を炎で包み、消え去る。"
    },
    "EN": {
      "name": "JALAPENO ZOMBIE",
      "description": "Normal attack: Blaze     Special attack: -\nA zombie with a Jalapeno for a head.\nOn touching an enemy it sets the whole field ablaze, then vanishes."
    },
    "ES": {
      "name": "ZOMBI JALAPEÑO",
      "description": "Ataque normal: Llamarada     Ataque especial: -\nUn zombi con un jalapeño por cabeza.\nAl tocar a un enemigo incendia todo el campo y desaparece."
    },
    "PT": {
      "name": "ZUMBI PIMENTA",
      "description": "Ataque normal: Labareda     Ataque especial: -\nUm zumbi com uma pimenta jalapeño na cabeça.\nAo tocar um inimigo, incendeia todo o campo e desaparece."
    },
    "KR": {
      "name": "할라피뇨 좀비",
      "description": "일반 공격：화염     특수 공격：-\n할라피뇨 머리를 한 좀비.\n적에게 닿으면 전장 전체를 불태우고 사라진다."
    }
