  "localization": {
    "ZS": {
      "name": "机枪豌豆僵尸",
      "description": "普通攻击：豌豆连射     特殊攻击：-\n头上长着机枪豌豆的僵尸。\n一边前进一边连射豌豆，接触敌人后啃咬。"
    },
    "ZT": {
      "name": "機槍豌豆殭屍",
      "description": "普通攻擊：豌豆連射     特殊攻擊：-\n頭上長著機槍豌豆的殭屍。\n一邊前進一邊連射豌豆，接觸敵人後啃咬。"
    },
    "JP": {
      "name": "ガトリングピーゾンビ",
      "description": "通常攻撃：豆の連射     特殊攻撃：-\nガトリングピーの頭をしたゾンビ。\n前進しながら豆を連射し、敵に触れるとかみつく。"
    },
    "EN": {
      "name": "GATLING PEA ZOMBIE",
      "description": "Normal attack: Pea barrage     Special attack: -\nA zombie with a Gatling Pea for a head.\nFires peas while advancing and bites on contact."
    },
    "ES": {
      "name": "ZOMBI GUISANTRALLADORA",
      "description": "Ataque normal: Ráfaga de guisantes     Ataque especial: -\nUn zombi con una guisantralladora por cabeza.\nDispara guisantes mientras avanza y muerde al contacto."
    },
    "PT": {
      "name": "ZUMBI METRALHERVILHA",
      "description": "Ataque normal: Rajada de ervilhas     Ataque especial: -\nUm zumbi com uma metralhervilha na cabeça.\nDispara ervilhas enquanto avança e morde ao encostar."
    },
    "KR": {
      "name": "개틀링 완두 좀비",
      "description": "일반 공격：완두 연사     특수 공격：-\n개틀링 완두 머리를 한 좀비.\n전진하며 완두를 연사하고, 적에게 닿으면 물어뜯는다."
    }
